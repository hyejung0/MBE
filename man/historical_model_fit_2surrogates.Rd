\deqn{\hat{\psi}_i \mid \psi_i \sim N_3(\psi_i, \Sigma_{y, i}), \quad \psi_i = (\mu, \Sigma)^T}{hat(psi)_i | psi_i ~ N_3(psi_i, Sigma_{y,i}), psi_i = (\mu, \Sigma)^T}
